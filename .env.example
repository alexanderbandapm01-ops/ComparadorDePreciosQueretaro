# Conexión a MySQL (el servidor de base de datos escucha en el puerto 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=comparador_precios_sostenible

# Puerto de la página web (http://localhost:3000)
PORT=3000

# Secreto para firmar las sesiones (pon cualquier texto largo)
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# Zona que muestra la página: queretaro (estado), metro (zona metropolitana) o todo (todo el país)
ZONA=queretaro

# Antigüedad máxima (en días, contados desde el precio más reciente) de un precio para usarlo
VENTANA_DIAS=120
